#!/usr/bin/env python3
"""AgentFleet command line: switch providers and run the fleet tools.

Profiles let one home switch between a custom gateway and the user's own
Claude login without reinstalling. Lanes keep their names across a switch;
only the models behind them change. Everything a switch touches is a setting
this bundle manages, and every write holds the same lock the installer and
startup hooks use.
"""
from __future__ import annotations

import argparse
import copy
import datetime as dt
import getpass
import importlib.util
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile
import urllib.error
import urllib.parse
import urllib.request

# Set before importing provider_catalog so no __pycache__ lands next to the
# installed scripts (the installer's inventory checks reject stray files).
sys.dont_write_bytecode = True
_HERE = Path(__file__).resolve().parent
SCRIPTS = _HERE if (_HERE / "provider_catalog.py").is_file() else _HERE.parent / "scripts"
sys.path.insert(0, str(SCRIPTS))
import provider_catalog  # noqa: E402
import agent_brain  # noqa: E402

try:
    sys.stdout.reconfigure(encoding="utf-8")
except Exception:
    pass

PROFILE_FORMAT = "agentfleet.profile.v1"
PROFILE_NAME_RE = re.compile(r"^[a-z0-9][a-z0-9-]{0,39}$")
# Device names Windows will not let a file be called, whatever the extension.
RESERVED_NAMES = {"con", "prn", "aux", "nul", *(f"com{n}" for n in range(1, 10)), *(f"lpt{n}" for n in range(1, 10))}
TOKEN_ENV_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")
LOCK_TIMEOUT = 30.0
DEFAULT_BASE_URL = "https://agentfleet.wecansync.com"
# Settings a profile owns. Nothing else in settings.json is read or written.
PROFILE_ENV_KEYS = (
    "ANTHROPIC_BASE_URL",
    "ANTHROPIC_DEFAULT_OPUS_MODEL",
    "ANTHROPIC_DEFAULT_SONNET_MODEL",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL",
    "ANTHROPIC_SMALL_FAST_MODEL",
    "CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY",
    "CLAUDE_CODE_MAX_CONTEXT_TOKENS",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW",
)
PROFILE_TOP_KEYS = ("model", "advisorModel", "modelPicker", "autoCompactWindow")
LANE_KEYS = ("model", "fallbacks", "preferred")
# Lane fields a profile keeps: the model choice plus the user's pin flag and effort.
LANE_CHOICE_KEYS = LANE_KEYS + ("preferredOnly", "preferredEffort")
PREFERRED_EFFORTS = ("low", "medium", "high", "xhigh", "max")
NATIVE_PICKER = [
    {"model": "default", "label": "Default", "description": "Claude Code's default model for your account"},
    {"model": "opus", "label": "Opus", "description": "Claude Opus through your Claude login"},
    {"model": "sonnet", "label": "Sonnet", "description": "Claude Sonnet through your Claude login"},
    {"model": "haiku", "label": "Haiku", "description": "Claude Haiku through your Claude login"},
]


class Paths:
    def __init__(self, args: argparse.Namespace) -> None:
        self.home = Path(args.home).expanduser().resolve() if args.home else Path.home().resolve()
        self.config = (
            Path(args.config_home).expanduser().resolve() if args.config_home
            else Path(os.environ.get("XDG_CONFIG_HOME") or self.home / ".config").resolve()
        )
        self.prefix = Path(args.prefix).expanduser().resolve() if args.prefix else self.home / ".local"
        self.claude = self.home / ".claude"
        self.settings = self.claude / "settings.json"
        self.fleet = self.claude / "fleet.json"
        self.legacy_fleet = self.config / "delegate-skills" / "config.json"
        self.policy = self.config / "delegate-skills" / "provider-policy.json"
        self.generator = self.config / "delegate-skills" / "generate-claude-agents.mjs"
        if not self.generator.is_file() and (SCRIPTS / "generate-claude-agents.mjs").is_file():
            self.generator = SCRIPTS / "generate-claude-agents.mjs"
        self.store = self.claude / "agentfleet"
        self.profiles = self.store / "profiles"
        self.secrets = self.store / "secrets"
        self.active = self.store / "active"
        data_home = Path(os.environ.get("XDG_DATA_HOME") or self.home / ".local" / "share")
        if os.name == "nt" and os.environ.get("LOCALAPPDATA"):
            data_home = Path(os.environ["LOCALAPPDATA"])
            self.releases = Path(os.environ.get("AGENTFLEET_HOME") or data_home / "AgentFleet")
        else:
            self.releases = Path(os.environ.get("AGENTFLEET_HOME") or data_home / "agentfleet")


def die(message: str, code: int = 1) -> "NoReturn":  # type: ignore[name-defined]
    print(f"agentfleet: {message}", file=sys.stderr)
    raise SystemExit(code)


def read_json(path: Path) -> dict:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        return {}
    except (OSError, UnicodeError, json.JSONDecodeError) as exc:
        die(f"cannot read {path}: {exc}")
    if not isinstance(value, dict):
        die(f"{path} is not a JSON object")
    return value


def atomic_write(path: Path, data: bytes, mode: int) -> None:
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    fd, raw = tempfile.mkstemp(prefix=f".{path.name}.", dir=str(path.parent))
    temp = Path(raw)
    try:
        os.write(fd, data)
        os.fsync(fd)
        os.close(fd)
        fd = -1
        os.chmod(temp, mode)
        os.replace(temp, path)
    finally:
        if fd >= 0:
            os.close(fd)
        temp.unlink(missing_ok=True)


def json_bytes(value: object) -> bytes:
    return (json.dumps(value, ensure_ascii=False, indent=2) + "\n").encode("utf-8")


def reconcile_module(paths: Paths):
    candidates = [SCRIPTS / "fleet-reconcile.py", paths.claude / "fleet-reconcile.py"]
    script = next((path for path in candidates if path.is_file()), None)
    if script is None:
        die("fleet-reconcile.py is missing; reinstall AgentFleet")
    spec = importlib.util.spec_from_file_location("agentfleet_reconcile", script)
    module = importlib.util.module_from_spec(spec)  # type: ignore[arg-type]
    spec.loader.exec_module(module)  # type: ignore[union-attr]
    return module


def context_sync_module(paths: Paths):
    candidates = [SCRIPTS / "sync-model-context.py", paths.claude / "sync-model-context.py"]
    script = next((path for path in candidates if path.is_file()), None)
    if script is None:
        die("sync-model-context.py is missing; reinstall AgentFleet")
    spec = importlib.util.spec_from_file_location("agentfleet_context_sync", script)
    module = importlib.util.module_from_spec(spec)  # type: ignore[arg-type]
    spec.loader.exec_module(module)  # type: ignore[union-attr]
    return module


def instructions_module():
    candidates = [SCRIPTS / "fleet_instructions.py", _HERE / "fleet_instructions.py", Path(__file__).resolve().parent / "fleet_instructions.py"]
    script = next((path for path in candidates if path.is_file()), None)
    if script is None:
        raise ImportError("fleet_instructions is not installed")
    spec = importlib.util.spec_from_file_location("agentfleet_instructions", script)
    module = importlib.util.module_from_spec(spec)  # type: ignore[arg-type]
    # Its dataclasses look the module up in sys.modules while it loads.
    sys.modules[spec.name] = module  # type: ignore[union-attr]
    spec.loader.exec_module(module)  # type: ignore[union-attr]
    return module


def valid_name(name: str) -> str:
    if not PROFILE_NAME_RE.fullmatch(name) or name in RESERVED_NAMES:
        die("profile names use lowercase letters, digits, and dashes (max 40 characters) and cannot be a device name such as con or nul")
    return name


def url_identity(url: object) -> str | None:
    """scheme://host:port of a gateway URL; None when there is no URL.

    A URL the catalog rejects (e.g. plain HTTP on a LAN) compares by its
    normalized text, so two such gateways never count as the same one.
    """
    try:
        return provider_catalog.endpoint_identity(url)
    except provider_catalog.CatalogError:
        return url.strip().rstrip("/").lower() if isinstance(url, str) and url.strip() else None


def saved_url(paths: Paths, name: str) -> str | None:
    try:
        env = json.loads((paths.profiles / f"{name}.json").read_text(encoding="utf-8")).get("env") or {}
    except (OSError, UnicodeError, json.JSONDecodeError, AttributeError):
        return None
    url = env.get("ANTHROPIC_BASE_URL") if isinstance(env, dict) else None
    return url if isinstance(url, str) else None


def gateway_name(url: str) -> str:
    """A readable default profile name from a gateway URL's host."""
    parsed = urllib.parse.urlparse(url)
    host = (parsed.hostname or "gateway").lower()
    if host == "localhost" or re.fullmatch(r"[0-9.]+|[0-9a-f:]+", host):
        try:
            port = parsed.port
        except ValueError:
            port = None
        return f"local-{port}" if port else "local"
    labels = [label for label in host.split(".") if label and label not in {"www", "api", "gateway", "llm", "ai"}]
    name = re.sub(r"[^a-z0-9-]+", "-", labels[0] if labels else "gateway").strip("-") or "gateway"
    name = name[:40]
    # Profile names become file names; Windows reserves device names.
    return f"{name}-gateway" if name in RESERVED_NAMES else name


def current_kind(settings: dict) -> str:
    env = settings.get("env") if isinstance(settings.get("env"), dict) else {}
    return "gateway" if env.get("ANTHROPIC_BASE_URL") else "native"


def active_name(paths: Paths, settings: dict) -> str:
    """The recorded active profile, unless the live settings contradict it
    (e.g. a reinstall switched providers without going through agentfleet)."""
    kind = current_kind(settings)
    try:
        name = paths.active.read_text(encoding="utf-8").strip()
    except OSError:
        name = ""
    if PROFILE_NAME_RE.fullmatch(name):
        saved = paths.profiles / f"{name}.json"
        try:
            saved_kind = json.loads(saved.read_text(encoding="utf-8")).get("kind") if saved.is_file() else ("native" if name == "native" else None)
        except (OSError, UnicodeError, json.JSONDecodeError, AttributeError):
            saved_kind = None
        env = settings.get("env") if isinstance(settings.get("env"), dict) else {}
        identity = url_identity(saved_url(paths, name))
        if saved_kind == kind and (kind == "native" or (identity is not None and identity == url_identity(env.get("ANTHROPIC_BASE_URL")))):
            return name
    env = settings.get("env") if isinstance(settings.get("env"), dict) else {}
    url = env.get("ANTHROPIC_BASE_URL")
    if not (isinstance(url, str) and url):
        return "native"
    # Never reuse the name of a saved profile that points at another gateway:
    # the next switch would save this setup over it.
    base = gateway_name(url)
    candidate, number = base, 2
    while (paths.profiles / f"{candidate}.json").is_file() and url_identity(saved_url(paths, candidate)) != url_identity(url):
        candidate = f"{base[:36]}-{number}"
        number += 1
    return candidate


def fleet_map(paths: Paths) -> tuple[dict, list[Path]]:
    present = [path for path in (paths.fleet, paths.legacy_fleet) if path.is_file()]
    if not present:
        die("no fleet map found; install AgentFleet first")
    present.sort(key=lambda path: path.stat().st_mtime, reverse=True)
    fleet = read_json(present[0])
    if not isinstance(fleet.get("lanes"), dict):
        die(f"{present[0]} has no lanes")
    return fleet, present


def snapshot(paths: Paths, settings: dict, fleet: dict, name: str) -> tuple[dict, str | None]:
    env = settings.get("env") if isinstance(settings.get("env"), dict) else {}
    profile = {
        "format": PROFILE_FORMAT,
        "name": name,
        "kind": current_kind(settings),
        "savedAt": dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "settings": {key: settings[key] for key in PROFILE_TOP_KEYS if key in settings},
        "env": {key: env[key] for key in PROFILE_ENV_KEYS if key in env},
        "lanes": {
            lane: {key: config[key] for key in LANE_CHOICE_KEYS if key in config}
            for lane, config in fleet.get("lanes", {}).items() if isinstance(config, dict)
        },
        "modelTiers": fleet.get("modelTiers", {}) if isinstance(fleet.get("modelTiers"), dict) else {},
        "excludedModels": [item for item in fleet.get("excludedModels") or [] if isinstance(item, str)],
        "reservedModels": [item for item in fleet.get("reservedModels") or [] if isinstance(item, str)],
    }
    if profile["kind"] == "gateway":
        try:
            profile["policy"] = provider_catalog.load_policy(paths.policy)
        except provider_catalog.CatalogError:
            print("agentfleet: the provider policy is invalid; saving this profile without it", file=sys.stderr)
    # The version marks profiles saved after the 2.0.1 migration; without a
    # known version the profile is treated as older and cleaned on apply.
    version = installed_version(paths)
    if version:
        profile["agentfleetVersion"] = version
    token = env.get("ANTHROPIC_AUTH_TOKEN")
    return profile, token if isinstance(token, str) and token else None


def installed_version(paths: Paths) -> str | None:
    version = read_json(paths.claude / ".claude-agents-config-install.json").get("version")
    return version if isinstance(version, str) and version else None


def save_profile(paths: Paths, profile: dict, token: str | None) -> None:
    for directory in (paths.store, paths.profiles, paths.secrets):
        directory.mkdir(parents=True, exist_ok=True, mode=0o700)
        os.chmod(directory, 0o700)
    # The profile and its token are two files. Drop the old token first: an
    # interrupted save then leaves a profile without a token, which `use`
    # refuses, and never a new URL paired with another gateway's token.
    secret = paths.secrets / f"{profile['name']}.token"
    secret.unlink(missing_ok=True)
    atomic_write(paths.profiles / f"{profile['name']}.json", json_bytes(profile), 0o600)
    if token:
        atomic_write(secret, token.encode("utf-8"), 0o600)


def load_profile(paths: Paths, name: str) -> tuple[dict, str | None]:
    path = paths.profiles / f"{name}.json"
    if not path.is_file():
        return {}, None
    profile = read_json(path)
    if profile.get("format") != PROFILE_FORMAT:
        die(f"{path} is not an AgentFleet profile")
    if name == "native" and profile.get("kind") != "native":
        return {}, None
    token = None
    secret = paths.secrets / f"{name}.token"
    if secret.is_file():
        token = secret.read_text(encoding="utf-8").strip() or None
    return profile, token


def native_profile(fleet: dict, paths: Paths, current_settings: dict | None = None) -> dict:
    resolved = reconcile_module(paths).native_fleet(fleet)
    chosen = {
        lane: {key: config[key] for key in LANE_CHOICE_KEYS if key in config}
        for lane, config in resolved.get("lanes", {}).items() if isinstance(config, dict)
    }
    native_settings = {
        "model": "default",
        "advisorModel": "opus",
        "modelPicker": {"options": NATIVE_PICKER, "replaceBuiltInOptions": True},
    }
    native_env = {"CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY": "0"}
    percent = provider_catalog.load_preferences(paths.home)["compactPercent"]
    compact = provider_catalog.compaction_settings(provider_catalog.NATIVE_CONTEXT_BASIS, percent)
    if compact is not None:
        native_settings["autoCompactWindow"] = compact["window"]
        native_env["CLAUDE_CODE_AUTO_COMPACT_WINDOW"] = str(compact["window"])
        native_env[provider_catalog.COMPACT_PERCENT_ENV] = str(compact["percent"])
    elif isinstance(current_settings, dict):
        current_env = current_settings.get("env") if isinstance(current_settings.get("env"), dict) else {}
        existing = current_settings.get("autoCompactWindow")
        if isinstance(existing, int) and not isinstance(existing, bool):
            native_settings["autoCompactWindow"] = existing
        existing_env = current_env.get("CLAUDE_CODE_AUTO_COMPACT_WINDOW")
        if isinstance(existing_env, str):
            native_env["CLAUDE_CODE_AUTO_COMPACT_WINDOW"] = existing_env
    return {
        "format": PROFILE_FORMAT,
        "name": "native",
        "kind": "native",
        "settings": native_settings,
        "env": native_env,
        "lanes": chosen,
        "modelTiers": fleet.get("modelTiers", {}),
        "excludedModels": [],
        "reservedModels": [],
    }


def fit_lanes(paths: Paths, fleet: dict, picker_rows: list[dict], policy: dict) -> dict:
    """Make every lane point at a model the target picker actually offers,
    judged by the target provider's policy."""
    offered = {row.get("model") for row in picker_rows if isinstance(row, dict)}
    lanes = fleet.get("lanes", {})
    if all(isinstance(c, dict) and c.get("model") in offered for c in lanes.values()):
        return fleet
    rows = [{"id": row["model"], "description": row.get("description", "")} for row in picker_rows if isinstance(row, dict) and row.get("model")]
    resolved, _picker, _pending, _catalog = reconcile_module(paths).resolve_fleet(fleet, {}, rows, policy)
    resolved.pop("_reconcile", None)
    return resolved


def apply_profile(paths: Paths, profile: dict, token: str | None) -> bool:
    """Apply a profile. Returns True when a gateway profile carries no saved
    provider policy (saved by an older version), so the current one is kept."""
    target_policy = None
    if profile.get("kind") == "gateway" and "policy" in profile:
        try:
            target_policy = provider_catalog.validate_policy(copy.deepcopy(profile["policy"]))
        except provider_catalog.CatalogError:
            die(f"profile {profile.get('name')} has an invalid saved provider policy; recreate it with: agentfleet add {profile.get('name')} --force")
    settings = read_json(paths.settings)
    fleet, fleet_paths = fleet_map(paths)
    env = settings.setdefault("env", {})
    if not isinstance(env, dict):
        die("settings.json env is not an object")
    # Clear every profile-owned key first so nothing from the old provider
    # leaks into the new one, then write the target's values.
    for key in PROFILE_ENV_KEYS + ("ANTHROPIC_AUTH_TOKEN",):
        env.pop(key, None)
    for key in PROFILE_TOP_KEYS:
        settings.pop(key, None)
    # An empty ANTHROPIC_API_KEY is ours (gateway profiles blank it); a real
    # key is the user's and is never touched.
    user_key = env.get("ANTHROPIC_API_KEY")
    if user_key == "":
        env.pop("ANTHROPIC_API_KEY")
    env.update({key: value for key, value in profile.get("env", {}).items() if key in PROFILE_ENV_KEYS})
    settings.update({key: value for key, value in profile.get("settings", {}).items() if key in PROFILE_TOP_KEYS})
    if profile.get("kind") == "gateway":
        if not env.get("ANTHROPIC_BASE_URL") or not token:
            die(f"profile {profile.get('name')} has no saved gateway URL or token; run: agentfleet save {profile.get('name')} while that gateway is active")
        env["ANTHROPIC_AUTH_TOKEN"] = token
        # Claude Code sends ANTHROPIC_API_KEY before the gateway token.
        if isinstance(user_key, str) and user_key:
            print("agentfleet: settings.json sets ANTHROPIC_API_KEY; Claude Code may send it to the gateway instead of the gateway token; remove it unless the gateway expects it.", file=sys.stderr)
        else:
            env["ANTHROPIC_API_KEY"] = ""
    # Compaction controls must stay paired; derive the env value from the
    # top-level one when a profile carries only one of them.
    if isinstance(settings.get("autoCompactWindow"), int):
        env["CLAUDE_CODE_AUTO_COMPACT_WINDOW"] = str(settings["autoCompactWindow"])
    compact = provider_catalog.compaction_settings(None, provider_catalog.load_preferences(paths.home)["compactPercent"])
    if compact is not None:
        settings["autoCompactWindow"] = compact["window"]
        env["CLAUDE_CODE_AUTO_COMPACT_WINDOW"] = str(compact["window"])
        env[provider_catalog.COMPACT_PERCENT_ENV] = str(compact["percent"])
    # Profiles saved before 2.0.1 carry the pins 1.0.0 shipped; the update
    # dropped them from the fleet, so switching back must not restore them.
    shipped = reconcile_module(paths).is_shipped_1_0_preference if "agentfleetVersion" not in profile else None
    for lane, values in profile.get("lanes", {}).items():
        if shipped and isinstance(values, dict) and shipped(lane, values.get("preferred")):
            values = {key: value for key, value in values.items() if key != "preferred"}
        target = fleet.get("lanes", {}).get(lane)
        if not isinstance(target, dict) or not isinstance(values, dict):
            continue
        # The model always comes from the profile when it has one; fallback
        # and preference lists are replaced wholesale, never merged.
        target.pop("fallbacks", None)
        target.pop("preferred", None)
        target.pop("preferredOnly", None)
        target.pop("preferredEffort", None)
        for key in LANE_CHOICE_KEYS:
            if key not in values:
                continue
            if key == "preferredOnly" and values[key] is not True:
                continue
            if key == "preferredEffort" and values[key] not in PREFERRED_EFFORTS:
                continue
            target[key] = values[key]
    if isinstance(profile.get("modelTiers"), dict):
        fleet["modelTiers"] = profile["modelTiers"]
    # Exclusions name one provider's models, so they travel with the profile.
    if isinstance(profile.get("excludedModels"), list):
        excluded = [item for item in profile["excludedModels"] if isinstance(item, str) and item.strip()]
        if excluded:
            fleet["excludedModels"] = excluded
        else:
            fleet.pop("excludedModels", None)
    # Reserved models are named per provider too, so they follow the profile;
    # a profile saved before 2.8.0 has none.
    saved_reserved = profile.get("reservedModels")
    reserved = [item for item in saved_reserved if isinstance(item, str) and item.strip()] if isinstance(saved_reserved, list) else []
    if reserved:
        fleet["reservedModels"] = reserved
    else:
        fleet.pop("reservedModels", None)
    policy = target_policy
    if policy is None:
        try:
            policy = provider_catalog.load_policy(paths.policy)
        except provider_catalog.CatalogError:
            policy = provider_catalog.generic_policy()
    picker = settings.get("modelPicker") if isinstance(settings.get("modelPicker"), dict) else {}
    fleet = fit_lanes(paths, fleet, picker.get("options") if isinstance(picker.get("options"), list) else [], policy)
    # One recoverable transaction: a crash mid-switch never leaves settings,
    # the fleet map, and the policy describing different providers.
    updates = {paths.settings: (json_bytes(settings), 0o600)}
    data = json_bytes(fleet)
    for path in {paths.fleet, paths.legacy_fleet} | set(fleet_paths):
        if path.parent.is_dir():
            updates[path] = (data, 0o644)
    if target_policy is not None:
        updates[paths.policy] = (json_bytes(target_policy), 0o644)
    reconcile_module(paths).transactional_write(paths.home, updates, [paths.home, paths.config])
    return profile.get("kind") == "gateway" and target_policy is None


def generator_path(paths: Paths) -> Path:
    if paths.generator.is_file():
        return paths.generator
    fallback = SCRIPTS / "generate-claude-agents.mjs"
    if fallback.is_file():
        return fallback
    return paths.generator


def run_generator(paths: Paths) -> int:
    node = shutil.which("node")
    gen = generator_path(paths)
    if not node or not gen.is_file():
        print("agentfleet: node or the agent generator is missing; run 'claude-fleet-sync' after fixing it", file=sys.stderr)
        return 1
    return subprocess.run([node, str(gen), "--home", str(paths.home), "--config-home", str(paths.config), "--quiet"]).returncode


def run_project_generator(paths: Paths, project: Path) -> tuple[int, str]:
    node = shutil.which("node")
    gen = generator_path(paths)
    if not node or not gen.is_file():
        return 1, "agentfleet: node or the agent generator is missing; run 'claude-fleet-sync' after fixing it"
    proc = subprocess.run(
        [node, str(gen), "--home", str(paths.home), "--config-home", str(paths.config), "--project", str(project), "--quiet"],
        capture_output=True,
        text=True,
    )
    err = proc.stderr.strip() if proc.stderr else (proc.stdout.strip() if proc.stdout else "")
    return proc.returncode, err


def with_lock(paths: Paths):
    # The startup hook can hold the lock for its reconcile, sync, and drift
    # steps, so wait longer than its worst case.
    fd, lock = provider_catalog.acquire_lock(paths.home, timeout=LOCK_TIMEOUT)
    if fd is None:
        die(f"another fleet writer (installer or startup hook) is busy; try again in a moment (lock: {provider_catalog.lock_path(paths.home)})")
    return fd, lock


def _auto_update_state_path(paths: Paths) -> Path:
    return paths.store / "auto-update.json"


def _read_auto_update_state(paths: Paths) -> dict:
    p = _auto_update_state_path(paths)
    try:
        raw = json.loads(p.read_text(encoding="utf-8"))
        return raw if isinstance(raw, dict) else {}
    except (OSError, json.JSONDecodeError):
        return {}


def _write_auto_update_state(paths: Paths, state: dict) -> None:
    paths.store.mkdir(parents=True, exist_ok=True, mode=0o700)
    try:
        os.chmod(paths.store, 0o700)
    except OSError:
        pass
    atomic_write(_auto_update_state_path(paths), json_bytes(state), 0o600)


def _update_auto_update_state(paths: Paths, mutate, timeout: float, required: bool = False) -> bool:
    """Read-modify-write auto-update.json under the shared lock, so a write
    never undoes a concurrent one (an `auto-update off` most of all).

    ``mutate`` changes the freshly read state in place and returns False to
    skip the write. Without the lock, a required write still happens (losing
    a report is worse than racing); an optional one is skipped."""
    fd, lock = provider_catalog.acquire_lock(paths.home, timeout=timeout)
    if fd is None and not required:
        return False
    try:
        state = _read_auto_update_state(paths)
        if mutate(state) is not False:
            _write_auto_update_state(paths, state)
        return True
    finally:
        if fd is not None:
            provider_catalog.release_lock(fd, lock)


def self_heal_markers(paths: Paths, settings: dict | None) -> None:
    """Silently restore AgentFleet's status markers without changing update intent."""
    try:
        if isinstance(settings, dict):
            name = active_name(paths, settings)
            if (name == "native" or (paths.profiles / f"{name}.json").is_file()) and not paths.active.is_file():
                paths.store.mkdir(parents=True, exist_ok=True, mode=0o700)
                os.chmod(paths.store, 0o700)
                atomic_write(paths.active, (name + "\n").encode("utf-8"), 0o600)
    except Exception:
        pass
    try:
        def record_default(state: dict) -> bool:
            if "enabled" in state:
                return False
            state["enabled"] = True
            return True
        _update_auto_update_state(paths, record_default, timeout=0.5)
    except Exception:
        pass


def cmd_profiles(paths: Paths, _args: argparse.Namespace) -> int:
    settings = read_json(paths.settings)
    self_heal_markers(paths, settings)
    active = active_name(paths, settings)
    names = {"native"}
    if paths.profiles.is_dir():
        names |= {path.stem for path in paths.profiles.glob("*.json") if PROFILE_NAME_RE.fullmatch(path.stem)}
    names.add(active)
    for name in sorted(names):
        profile, _ = load_profile(paths, name)
        kind = profile.get("kind") or ("native" if name == "native" else current_kind(settings))
        where = (profile.get("env") or {}).get("ANTHROPIC_BASE_URL", "") if profile else ""
        if name == active and current_kind(settings) == "gateway":
            where = (settings.get("env") or {}).get("ANTHROPIC_BASE_URL", where)
        marker = "*" if name == active else " "
        detail = f"gateway {where}" if kind == "gateway" else "Claude login (subscription or API key)"
        saved = "" if profile or name == active else " (built in)"
        if kind == "gateway" and profile:
            policy = profile.get("policy")
            saved += f" (policy: {policy.get('provider', '?')})" if isinstance(policy, dict) else " (no saved policy)"
        print(f"{marker} {name:<16} {detail}{saved}")
    print("\nSwitch with: agentfleet use <name>")
    return 0


def cmd_save(paths: Paths, args: argparse.Namespace) -> int:
    name = valid_name(args.name)
    fd, lock = with_lock(paths)
    try:
        settings = read_json(paths.settings)
        if name == "native" and current_kind(settings) != "native":
            die("'native' is reserved for your Claude login; save this gateway under another name")
        fleet, _ = fleet_map(paths)
        profile, token = snapshot(paths, settings, fleet, name)
        save_profile(paths, profile, token)
        atomic_write(paths.active, (name + "\n").encode("utf-8"), 0o600)
    finally:
        provider_catalog.release_lock(fd, lock)
    print(f"Saved the current {profile['kind']} configuration as profile '{name}'.")
    return 0


def cmd_use(paths: Paths, args: argparse.Namespace) -> int:
    name = valid_name(args.name)
    # Regenerating agents needs Node; check before anything changes so a
    # switch is never left half-applied.
    if not shutil.which("node") or not paths.generator.is_file():
        die("switching needs Node.js 18+ and the agent generator; install Node.js, then rerun")
    fd, lock = with_lock(paths)
    try:
        settings = read_json(paths.settings)
        fleet, _ = fleet_map(paths)
        current = active_name(paths, settings)
        if current == name and not args.force:
            print(f"Already using '{name}'. (Use --force to re-apply it.)")
            return 0
        target, target_token = load_profile(paths, name)
        if not target:
            if name != "native":
                die(f"no saved profile '{name}'. Saved profiles: agentfleet profiles")
            target = native_profile(fleet, paths, settings)
        if target.get("kind") == "native":
            target = native_profile(fleet, paths, settings)
        if target.get("kind") == "gateway" and not target_token:
            die(f"profile '{name}' has no saved gateway token; switch to that gateway and run: agentfleet save {name}")
        # Save where we are first, so switching back restores it exactly.
        # (--force on the active profile means "re-apply the saved copy",
        # so the live state must not be saved over it first.)
        if current != name:
            profile, token = snapshot(paths, settings, fleet, current)
            save_profile(paths, profile, token)
        legacy = apply_profile(paths, target, target_token)
        atomic_write(paths.active, (name + "\n").encode("utf-8"), 0o600)
    finally:
        provider_catalog.release_lock(fd, lock)
    code = run_generator(paths)
    if code != 0:
        print("agentfleet: settings switched, but regenerating agents failed; run 'claude-fleet-sync' to retry", file=sys.stderr)
        return code
    kind = target.get("kind")
    via = "your Claude login" if kind == "native" else (target.get("env") or {}).get("ANTHROPIC_BASE_URL", "the gateway")
    if legacy:
        print(f"Profile '{name}' was saved by an older version without a provider policy; keeping the current one.")
    print(f"Switched to '{name}' ({via}). Previous setup saved as '{current}'.")
    print("Restart Claude Code to apply.")
    return 0


def read_token(name: str, env_name: str | None) -> str:
    """The new profile's gateway token: from an environment variable, or typed
    with hidden input. There is deliberately no flag that takes the token."""
    if env_name:
        if not TOKEN_ENV_RE.fullmatch(env_name):
            die("--token-env must name an environment variable (letters, digits, and underscores)")
        value = os.environ.get(env_name, "")
        if not value:
            die("the environment variable named by --token-env is not set or is empty (pass its name, e.g. --token-env MY_TOKEN, not $MY_TOKEN)")
    elif sys.stdin.isatty() and sys.stderr.isatty():
        value = getpass.getpass(f"Token for {name} (input hidden): ")
    else:
        die("no token: pass --token-env VAR, or run this in a terminal to type it (input hidden)")
    value = value.strip()
    if not value or "\r" in value or "\n" in value:
        die("the token is empty or contains a line break")
    return value


def cmd_add(paths: Paths, args: argparse.Namespace) -> int:
    name = valid_name(args.name)
    if name == "native":
        die("'native' is reserved for your Claude login; choose another name")
    url = args.gateway_url.strip().rstrip("/")
    parsed = urllib.parse.urlparse(url)
    try:
        identity = provider_catalog.endpoint_identity(url)
    except provider_catalog.CatalogError:
        if parsed.scheme == "http" and not parsed.username and not parsed.password:
            die("HTTP gateway URLs are allowed only for loopback hosts, with --allow-insecure-http")
        die("--gateway-url must be an https URL without embedded credentials")
    if parsed.scheme == "http" and not args.allow_insecure_http:
        die("HTTP gateway URLs are allowed only for loopback hosts, with --allow-insecure-http")
    # Everything that can refuse runs before the network call and the lock.
    settings = read_json(paths.settings)
    active = active_name(paths, settings)
    existing, _ = load_profile(paths, name)
    if name == active and not args.force:
        die(f"profile '{name}' is active; pass --force to replace it (it is re-applied at once)")
    if existing and not args.force:
        die(f"profile '{name}' already exists; pass --force to replace it (its saved token is replaced too)")
    switch = args.use or name == active
    if switch and (not shutil.which("node") or not paths.generator.is_file()):
        die("switching needs Node.js 18+ and the agent generator; install Node.js, then rerun")
    if paths.profiles.is_dir():
        for other in sorted(path.stem for path in paths.profiles.glob("*.json")):
            if other != name and url_identity(saved_url(paths, other)) == identity:
                print(f"note: profile '{other}' already uses this gateway")
    token = read_token(name, args.token_env)
    # Discovery happens outside the lock, as in the startup hook.
    print(f"Checking {url} ...", end=" ", flush=True)
    rows, complete, error = provider_catalog.fetch_catalog(url, token, timeout=15.0)
    if not complete:
        print(flush=True)
        hint = " (check the token)" if error and ("HTTP 401" in error or "HTTP 403" in error) else ""
        die(f"could not list models at {url}: {error or 'incomplete response'}{hint}")
    if not rows:
        print(flush=True)
        die(f"{url} returned no models; nothing to assign lanes to")
    print(f"{len(rows)} models.")
    reconcile = reconcile_module(paths)
    policy = provider_catalog.generic_policy(provider=name)
    fd, lock = with_lock(paths)
    try:
        settings = read_json(paths.settings)
        active = active_name(paths, settings)
        if (paths.profiles / f"{name}.json").is_file() and not args.force:
            die(f"profile '{name}' already exists; pass --force to replace it (its saved token is replaced too)")
        fleet, _ = fleet_map(paths)
        # Rank every lane against this provider alone: the other provider's
        # pins, exclusions, and tier labels name models it does not have.
        fresh = copy.deepcopy(fleet)
        fresh.pop("excludedModels", None)
        fresh.pop("reservedModels", None)
        fresh["modelTiers"] = {}
        for config in fresh.get("lanes", {}).values():
            if isinstance(config, dict):
                for key in LANE_KEYS + ("preferredOnly",):
                    config.pop(key, None)
        resolved, picker, pending, catalog = reconcile.resolve_fleet(fresh, {}, rows, policy)
        missing = [item for item in pending if "no live approved candidate" in item]
        if missing:
            die("could not assign a model to every lane: " + "; ".join(missing[:3]))
        resolved.pop("_reconcile", None)
        chosen = reconcile.gateway_settings(resolved, catalog)
        sized, _message, _budget = reconcile.reconcile_context(
            {"model": chosen["model"], "env": {"ANTHROPIC_BASE_URL": url}}, catalog, paths.home,
        )
        window = sized.get("autoCompactWindow")
        env = {"ANTHROPIC_BASE_URL": url, **chosen["env"], "CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY": "1"}
        if isinstance(window, int):
            env["CLAUDE_CODE_AUTO_COMPACT_WINDOW"] = str(window)
        max_context = (sized.get("env") or {}).get("CLAUDE_CODE_MAX_CONTEXT_TOKENS")
        if max_context:
            env["CLAUDE_CODE_MAX_CONTEXT_TOKENS"] = max_context
        profile_settings = {"model": chosen["model"], "advisorModel": chosen["advisorModel"], "modelPicker": picker}
        if isinstance(window, int):
            profile_settings["autoCompactWindow"] = window
        profile = {
            "format": PROFILE_FORMAT,
            "name": name,
            "kind": "gateway",
            "savedAt": dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
            "settings": profile_settings,
            "env": env,
            "lanes": {lane: {key: config[key] for key in LANE_CHOICE_KEYS if key in config}
                      for lane, config in resolved.get("lanes", {}).items() if isinstance(config, dict)},
            "modelTiers": {},
            "excludedModels": [],
            "reservedModels": [],
            "policy": policy,
        }
        version = installed_version(paths)
        if version:
            profile["agentfleetVersion"] = version
        if switch and active != name:
            current, current_token = snapshot(paths, settings, fleet, active)
            save_profile(paths, current, current_token)
        save_profile(paths, profile, token)
        if switch:
            apply_profile(paths, profile, token)
            atomic_write(paths.active, (name + "\n").encode("utf-8"), 0o600)
            # Seed the startup hook's cache for the new endpoint.
            cache = paths.claude / "cache"
            cache.mkdir(parents=True, exist_ok=True)
            payload = provider_catalog.cache_payload(rows, url, token, provider=name)
            atomic_write(cache / "provider-models-cache.json", json_bytes(payload), 0o600)
    finally:
        provider_catalog.release_lock(fd, lock)
    lanes = profile["lanes"]
    shown = ", ".join(f"{lane} -> {lanes[lane]['model']}" for lane in ("plan", "implement", "review") if lane in lanes and lanes[lane].get("model"))
    extra = len(lanes) - 3
    print(f"Ranked {len(lanes)} lanes: {shown}" + (f" (+{extra} more)" if extra > 0 else ""))
    print(f"Saved profile '{name}' (policy: every model approved; tighten with /fleet-setup).")
    if not switch:
        print(f"Switch with: agentfleet use {name}")
        return 0
    code = run_generator(paths)
    if code != 0:
        print("agentfleet: settings switched, but regenerating agents failed; run 'claude-fleet-sync' to retry", file=sys.stderr)
        return code
    previous = f" Previous setup saved as '{active}'." if active != name else ""
    print(f"Switched to '{name}' ({url}).{previous} Restart Claude Code to apply.")
    return 0


def cmd_remove(paths: Paths, args: argparse.Namespace) -> int:
    name = valid_name(args.name)
    if name == "native":
        die("'native' is built in and cannot be removed")
    settings = read_json(paths.settings)
    if active_name(paths, settings) == name:
        die(f"'{name}' is the active profile; switch first: agentfleet use <other>")
    profile, _ = load_profile(paths, name)
    if not profile:
        die(f"no saved profile '{name}'")
    where = (profile.get("env") or {}).get("ANTHROPIC_BASE_URL") or "Claude login"
    if not args.yes:
        if not (sys.stdin.isatty() and sys.stderr.isatty()):
            die("pass --yes to remove without a prompt")
        if input(f"Remove profile '{name}' ({where}) and its saved token? [y/N] ").strip().lower() not in {"y", "yes"}:
            print("Kept.")
            return 0
    fd, lock = with_lock(paths)
    try:
        (paths.profiles / f"{name}.json").unlink(missing_ok=True)
        (paths.secrets / f"{name}.token").unlink(missing_ok=True)
    finally:
        provider_catalog.release_lock(fd, lock)
    print(f"Removed profile '{name}' and its saved token.")
    return 0


def run_tool(paths: Paths, script: str, extra: list[str]) -> int:
    path = paths.claude / script
    if not path.is_file():
        die(f"{path} is missing; reinstall AgentFleet")
    command = [sys.executable, str(path), "--home", str(paths.home), "--config-home", str(paths.config), *extra]
    return subprocess.run(command).returncode


def cmd_status(paths: Paths, _args: argparse.Namespace) -> int:
    settings = read_json(paths.settings)
    self_heal_markers(paths, settings)
    label = ""
    if current_kind(settings) == "gateway":
        try:
            label = f", policy: {provider_catalog.load_policy(paths.policy).get('provider')}"
        except provider_catalog.CatalogError:
            label = ", policy: invalid"
    print(f"Active profile: {active_name(paths, settings)} ({current_kind(settings)}{label})", flush=True)
    return run_tool(paths, "claude-fleet-setup.py", ["--audit"])


def cmd_doctor(paths: Paths, _args: argparse.Namespace) -> int:
    return run_tool(paths, "claude-agents-doctor.py", ["--check"])


def cmd_sync(paths: Paths, _args: argparse.Namespace) -> int:
    return run_generator(paths)


def _effective_preferences(paths: Paths) -> tuple[dict, set[str]]:
    preferences = provider_catalog.load_preferences(paths.home)
    raw = provider_catalog.load_json(provider_catalog.preferences_path(paths.home))
    raw = raw if isinstance(raw, dict) else {}
    explicit = set()
    if provider_catalog.valid_compact_percent(raw.get("compactPercent")):
        explicit.add("compactPercent")
    if raw.get("reviewerAccess") in provider_catalog.REVIEWER_ACCESS:
        explicit.add("reviewerAccess")
    if isinstance(raw.get("learn"), bool):
        explicit.add("learn")
    if raw.get("workStyle") in provider_catalog.WORK_STYLES:
        explicit.add("workStyle")
    if isinstance(raw.get("agentBrain"), bool):
        explicit.add("agentBrain")
    if isinstance(raw.get("askFirst"), bool):
        explicit.add("askFirst")
    if isinstance(raw.get("branchCheck"), bool):
        explicit.add("branchCheck")
    return preferences, explicit


def render_rules_file(paths: Paths, changes: dict) -> int:
    """Save ``changes`` to the preferences and re-render ~/.claude/rules/agentfleet.md
    for them, under the shared lock. Only a file AgentFleet itself rendered is
    rewritten: one without the marker is the user's own, and one with the
    marker that matches no rendering carries the user's edits."""
    fd, lock = with_lock(paths)
    try:
        preferences = provider_catalog.write_preferences(paths.home, changes)
        template_path = paths.claude / "agentfleet" / "policy-template.md"
        target = paths.claude / "rules" / "agentfleet.md"
        if not template_path.is_file():
            print("Policy template is missing; run agentfleet update", file=sys.stderr)
            return 1
        template = template_path.read_text(encoding="utf-8")
        should_render = not target.exists()
        if target.exists():
            try:
                current = target.read_text(encoding="utf-8")
            except (OSError, UnicodeError):
                current = ""
            if "claude-agents-config:managed" not in current:
                should_render = False
            elif current in provider_catalog.policy_renderings(template):
                should_render = True
            else:
                print(f"{target} has your own edits, so it was not rewritten and the new setting "
                      "is not in effect yet. Move your own rules to another file in that folder "
                      "(AgentFleet updates replace this one), then run this command again.",
                      file=sys.stderr)
                return 1
        if should_render:
            rendered = provider_catalog.render_policy_for(template, preferences)
            atomic_write(target, rendered.encode("utf-8"), 0o644)
    finally:
        provider_catalog.release_lock(fd, lock)
    return 0


def cmd_config(paths: Paths, args: argparse.Namespace) -> int:
    setting = args.setting
    value = args.value
    preferences, explicit = _effective_preferences(paths)
    if setting is None:
        compact = preferences["compactPercent"]
        compact_text = "off" if compact == "off" else f"{compact}% of each model's context"
        reviewer = preferences["reviewerAccess"]
        learn = "on" if preferences["learn"] else "off"
        work_style = preferences["workStyle"]
        brain_state = "on" if preferences["agentBrain"] is True else ("off" if preferences["agentBrain"] is False else "auto")
        ask_first = "on" if preferences["askFirst"] else "off"
        branch_check = "on" if preferences["branchCheck"] else "off"
        for key, display in (
            ("compactPercent", f"compact: {compact_text}"),
            ("reviewerAccess", f"reviewer-access: {reviewer}"),
            ("learn", f"learn: {learn}"),
            ("workStyle", f"work-style: {work_style}"),
            ("askFirst", f"ask-first: {ask_first}"),
            ("branchCheck", f"branch-check: {branch_check}"),
            ("agentBrain", f"agent-brain: {brain_state}"),
        ):
            suffix = " (default)" if key not in explicit else ""
            if key == "agentBrain" and agent_brain.find_binary(paths.home) is None:
                if preferences["agentBrain"] is None:
                    display, suffix = "agent-brain: not installed", ""
                elif preferences["agentBrain"] is True:
                    suffix += ", not installed"
            elif key == "agentBrain" and preferences["agentBrain"] is not False and not agent_brain.connected(paths.home):
                suffix += ", not connected"
            print(display + suffix)
        state = "unknown"
        try:
            result = provider_catalog.claude_cli(paths.home, "plugin", "list", "--json")
            if result is not None and result.returncode == 0:
                plugins = json.loads(result.stdout)
                if isinstance(plugins, dict):
                    plugins = plugins.get("plugins")
                if isinstance(plugins, list):
                    plugin = next((item for item in plugins if isinstance(item, dict) and item.get("id") == "fast-jev-compaction@agentfleet"), None)
                    state = "not installed" if plugin is None else ("on" if plugin.get("enabled") is True else "off")
        except (OSError, ValueError, TypeError):
            pass
        print(f"jev: {state}")
        import fleet_configure
        for key in ("statusBand", "laneGuard", "autoUpdate"):
            try:
                value = fleet_configure.current(sys.modules[__name__], paths, key)
                print(f"{key}: {fleet_configure.display(value)}")
            except (OSError, ValueError, RuntimeError):
                print(f"{key}: unknown")
        return 0

    if value is None:
        print(f"agentfleet: config {setting} requires a value", file=sys.stderr)
        return 2
    change: dict
    if setting == "compact":
        compact_value: object = value
        if value != "off":
            try:
                compact_value = int(value)
            except ValueError:
                compact_value = value
        try:
            provider_catalog.write_preferences(paths.home, {"compactPercent": compact_value})
        except ValueError as exc:
            print(f"agentfleet: {exc}", file=sys.stderr)
            return 2
        if compact_value == "off":
            fd, lock = with_lock(paths)
            try:
                settings = read_json(paths.settings)
                env = settings.get("env")
                if isinstance(env, dict):
                    env.pop(provider_catalog.COMPACT_PERCENT_ENV, None)
                    atomic_write(paths.settings, json_bytes(settings), 0o600)
            finally:
                provider_catalog.release_lock(fd, lock)
            print("AgentFleet no longer manages auto-compact; Claude Code's default applies. Restart Claude Code to apply.")
            return 0
        fd, lock = with_lock(paths)
        try:
            settings = read_json(paths.settings)
            sync_payload = {}
            if isinstance(settings, dict):
                sync_payload["model"] = settings.get("model")
            result = context_sync_module(paths).update_context(
                sync_payload, paths.home, paths.config, already_locked=True, percent_override=compact_value,
            )
        finally:
            provider_catalog.release_lock(fd, lock)
        if result is None:
            print("Auto-compact preference saved; the active model's context is unavailable, so the window was not changed.")
            return 0
        print(f"Auto-compact set to {compact_value}% of each model's context. Restart Claude Code once to apply; switching models keeps it.")
        return 0

    if setting == "reviewer-access":
        previous = provider_catalog.load_preferences(paths.home)["reviewerAccess"]
        try:
            provider_catalog.write_preferences(paths.home, {"reviewerAccess": value})
        except ValueError as exc:
            print(f"agentfleet: {exc}", file=sys.stderr)
            return 2
        code = cmd_sync(paths, args)
        if code != 0:
            # Keep the preference in step with the agents that are installed.
            provider_catalog.write_preferences(paths.home, {"reviewerAccess": previous})
            print(f"agentfleet: regenerating the agents failed; reviewer access stays {previous}", file=sys.stderr)
            return code
        print(f"Reviewer access set to {value}. Restart Claude Code to apply.")
        return 0

    if setting == "work-style":
        if value not in provider_catalog.WORK_STYLES:
            print(f"agentfleet: work-style must be one of {', '.join(provider_catalog.WORK_STYLES)}", file=sys.stderr)
            return 2
        if render_rules_file(paths, {"workStyle": value}):
            return 1
        print(f"Work style set to {value}. Restart Claude Code to apply.")
        return 0

    if setting == "ask-first":
        if value not in {"on", "off"}:
            print("agentfleet: ask-first must be on or off", file=sys.stderr)
            return 2
        if render_rules_file(paths, {"askFirst": value == "on"}):
            return 1
        if value == "on":
            print("Claude will investigate and agree on the approach before large, unclear or risky tasks. Restart Claude Code to apply.")
        else:
            print("Claude will start tasks without the ask-first steps. Restart Claude Code to apply.")
        return 0

    if setting == "branch-check":
        if value not in {"on", "off"}:
            print("agentfleet: branch-check must be on or off", file=sys.stderr)
            return 2
        if render_rules_file(paths, {"branchCheck": value == "on"}):
            return 1
        if value == "on":
            print("Before changing files in a git repository, Claude will check the branch and ask which one to use. Restart Claude Code to apply.")
        else:
            print("Claude will change files without checking the branch first. Restart Claude Code to apply.")
        return 0

    if setting == "context-mode":
        if value not in {"on", "off", "status"}:
            print("agentfleet: context-mode must be on, off, or status", file=sys.stderr)
            return 2
        try:
            import context_mode
            if value == "status":
                print(f"context-mode: {context_mode.status(paths.home)}")
                return 0
            if value == "on":
                context_mode.enable(paths.home)
                if not context_mode.node_runtime_available(paths.home):
                    print("Warning: Context Mode requires Node.js 22.5 or later at runtime.")
                print("Context Mode is enabled for your user scope. Restart Claude Code, then run /context-mode:ctx-doctor to verify the setup.")
            else:
                context_mode.disable(paths.home)
                print("Context Mode is disabled; the plugin and its data remain installed. Restart Claude Code to apply.")
            return 0
        except ImportError:
            print("agentfleet: context-mode support is missing; reinstall AgentFleet", file=sys.stderr)
            return 1
        except context_mode.ContextModeError as exc:
            print(f"agentfleet: {exc}", file=sys.stderr)
            return 1

    if setting == "agent-brain":
        if value not in {"on", "off"}:
            print("agentfleet: agent-brain must be on or off", file=sys.stderr)
            return 2
        enabled = value == "on"
        binary = agent_brain.find_binary(paths.home)
        if enabled and binary is None:
            print(f"Installing agent-brain from {agent_brain.DEFAULT_BASE_URL} ...")
            try:
                version, binary = agent_brain.install(paths.home)
            except agent_brain.AgentBrainError as exc:
                # Nothing is saved, so the choice stays open.
                print(f"agentfleet: could not install agent-brain: {exc}", file=sys.stderr)
                return 1
            print(f"Installed agent-brain {version} at {binary}")
        try:
            provider_catalog.write_preferences(paths.home, {"agentBrain": enabled})
        except ValueError as exc:
            print(f"agentfleet: {exc}", file=sys.stderr)
            return 2
        if binary is not None:
            # agent-brain writes and removes its own hooks.
            code, output = (agent_brain.connect if enabled else agent_brain.disconnect)(paths.home, binary)
            if code:
                print(f"agentfleet: agent-brain {'install' if enabled else 'uninstall'} failed: {output[-500:]}", file=sys.stderr)
                return 1
            print("agent-brain is connected to Claude Code and records the tokens and cost of each session." if enabled
                  else "agent-brain is disconnected from Claude Code; it stays installed and keeps its data.")
        release = current_release(paths)
        if release is None:
            print("No downloaded release found; run agentfleet update to update the fleet lanes.", file=sys.stderr)
            return 1
        # The lanes get or lose the memory search tool.
        command = [sys.executable, str(release / "bin" / "install.py"), "--apply", "--no-configure", "--no-wizard",
                   "--home", str(paths.home), "--prefix", str(paths.prefix), "--config-home", str(paths.config)]
        return subprocess.run(command).returncode

    if setting == "learn":
        learn = value == "on"
        if value not in {"on", "off"}:
            print("agentfleet: learn must be on or off", file=sys.stderr)
            return 2
        try:
            provider_catalog.write_preferences(paths.home, {"learn": learn})
        except ValueError as exc:
            print(f"agentfleet: {exc}", file=sys.stderr)
            return 2
        status = "on" if learn else "off"
        print(
            f"Learning is {status}. When on, it counts command names, tool names, documentation sites and slash commands "
            "per project (never prompt text) in ~/.claude/agentfleet/usage/. "
            "Run agentfleet suggest --forget to delete it."
        )
        return 0
    return 2


def cmd_configure(paths: Paths, args: argparse.Namespace) -> int:
    import fleet_configure
    return fleet_configure.run(sys.modules[__name__], paths, args)


def cmd_jev(paths: Paths, args: argparse.Namespace) -> int:
    plugin_id = "fast-jev-compaction@agentfleet"
    if args.action == "on":
        try:
            metadata = json.loads((paths.claude / ".claude-agents-config-install.json").read_text(encoding="utf-8"))
        except (OSError, UnicodeError, json.JSONDecodeError):
            metadata = {}
        if not isinstance(metadata, dict) or (metadata.get("modsMarketplace") is not True and metadata.get("modsState") != "registered"):
            print("AgentFleet mods are not registered. Run: agentfleet update --mods", file=sys.stderr)
            return 1
        # An installed but disabled plugin is turned back on with enable;
        # install covers the first time.
        listed = provider_catalog.claude_cli(paths.home, "plugin", "list", "--json")
        try:
            present = any(isinstance(item, dict) and item.get("id") == plugin_id for item in json.loads(listed.stdout)) if listed and listed.returncode == 0 else False
        except (ValueError, TypeError):
            present = False
        result = provider_catalog.claude_cli(paths.home, "plugin", "enable" if present else "install", plugin_id)
        if result is None:
            print("agentfleet: Claude CLI is missing or could not install fast-jev-compaction", file=sys.stderr)
            return 1
        if result.returncode != 0:
            print("agentfleet: Claude CLI failed to install fast-jev-compaction", file=sys.stderr)
            return 1
        print(
            "fast-jev-compaction is on. It needs a TypeSafe API key: set it in Claude Code with /plugin "
            "(fast-jev-compaction → Configure), or export TYPESAFE_API_KEY in your shell profile. "
            "The key is saved in ~/.claude/settings.json when you enter it in the configure wizard. "
            "When Claude Code compacts the main conversation, "
            "its text is sent to api.typesafe.ai. Restart Claude Code to apply."
        )
        return 0
    if args.action == "off":
        result = provider_catalog.claude_cli(paths.home, "plugin", "disable", plugin_id)
        if result is None:
            print("agentfleet: Claude CLI is missing or could not disable fast-jev-compaction", file=sys.stderr)
            return 1
        if result.returncode != 0:
            print("agentfleet: Claude CLI failed to disable fast-jev-compaction", file=sys.stderr)
            return 1
        print("fast-jev-compaction is off. Restart Claude Code to apply.")
        return 0
    result = provider_catalog.claude_cli(paths.home, "plugin", "list", "--json")
    if result is None:
        print("agentfleet: Claude CLI is missing or could not list plugins", file=sys.stderr)
        return 1
    if result.returncode != 0:
        print("agentfleet: Claude CLI failed to list plugins", file=sys.stderr)
        return 1
    try:
        installed = json.loads(result.stdout)
    except (ValueError, TypeError):
        print("agentfleet: Claude CLI returned invalid plugin JSON", file=sys.stderr)
        return 1
    if isinstance(installed, dict):
        installed = installed.get("plugins")
    if not isinstance(installed, list) or any(not isinstance(item, dict) for item in installed):
        print("agentfleet: Claude CLI returned an unsupported plugin list", file=sys.stderr)
        return 1
    plugin = next((item for item in installed if item.get("id") == plugin_id), None)
    if plugin is None:
        state = "not installed"
    elif plugin.get("enabled") is True:
        state = "installed, enabled"
    else:
        state = "installed, disabled"
    settings_env = read_json(paths.settings).get("env")
    settings_key = settings_env.get("TYPESAFE_API_KEY") if isinstance(settings_env, dict) else None
    # An empty value is no key: the mod treats it the same way.
    key_state = "set" if os.environ.get("TYPESAFE_API_KEY") or settings_key else "not set"
    print(f"fast-jev-compaction: {state}")
    print(f"TypeSafe API key: {key_state}")
    return 0


def cmd_report(paths: Paths, args: argparse.Namespace) -> int:
    import fleet_watch
    days = getattr(args, "days", 7)
    if not isinstance(days, int) or days < 1:
        print("agentfleet: --days must be 1 or more", file=sys.stderr)
        return 2
    data = fleet_watch.report(paths.home, days=days)
    if getattr(args, "json", False):
        print(json.dumps(data, indent=2))
        return 0
    if not data.get("lanes"):
        print("No lane reports yet.")
        return 0
    print(fleet_watch.format_report(data))
    return 0


def cmd_instructions(paths: Paths, args: argparse.Namespace) -> int:
    try:
        module = instructions_module()
    except ImportError:
        print("instruction check is not installed; run agentfleet update", file=sys.stderr)
        return 1
    forwarded = []
    if args.project:
        forwarded.extend(["--project", args.project])
    if args.check:
        forwarded.append("--check")
    return module.main(forwarded, paths.home)


def cmd_suggest(paths: Paths, args: argparse.Namespace) -> int:
    import fleet_suggest
    forwarded: list[str] = ["--home", str(paths.home)]
    if getattr(args, "project", None):
        forwarded.extend(["--project", args.project])
    if getattr(args, "json", False):
        forwarded.append("--json")
    if getattr(args, "dismiss", None):
        forwarded.append("--dismiss")
        forwarded.extend(args.dismiss)
    if getattr(args, "seen", False):
        forwarded.append("--seen")
    if getattr(args, "forget", False):
        forwarded.append("--forget")
    return fleet_suggest.main(forwarded)


def check_project_target(paths: Paths, project_dir: Path) -> None:
    """Refuse a project whose .claude (or its agents directory) is a symlink
    or resolves to the global ~/.claude: project agents written or pruned
    there would replace the global fleet."""
    for path in (project_dir / ".claude", project_dir / ".claude" / "agents"):
        if path.is_symlink():
            die(f"refusing project overrides through symlinked {path}")
    if (project_dir / ".claude").resolve() == paths.claude.resolve():
        die(f"{project_dir} uses your global Claude directory; project overrides need a project of their own")


def cmd_project_pin(paths: Paths, args: argparse.Namespace) -> int:
    project_dir = Path(args.dir).expanduser().resolve() if getattr(args, "dir", None) else Path.cwd().resolve()
    check_project_target(paths, project_dir)
    lane = args.lane
    if lane.startswith("fleet-"):
        lane = lane[len("fleet-"):]

    fleet_data = read_json(paths.fleet)
    if not fleet_data or not isinstance(fleet_data.get("lanes"), dict):
        if paths.legacy_fleet.is_file():
            fleet_data = read_json(paths.legacy_fleet)
        else:
            die("no fleet map found; install AgentFleet first")
    valid_lanes = fleet_data.get("lanes", {})
    if not isinstance(valid_lanes, dict) or lane not in valid_lanes:
        available = ", ".join(sorted(valid_lanes.keys())) if isinstance(valid_lanes, dict) else ""
        die(f"unknown lane '{lane}'; available lanes: {available}")

    local_path = project_dir / ".claude" / "fleet.local.json"
    previous_bytes: bytes | None = None
    if local_path.is_file():
        try:
            previous_bytes = local_path.read_bytes()
            local_fleet = json.loads(previous_bytes.decode("utf-8"))
        except (OSError, UnicodeError, json.JSONDecodeError) as exc:
            die(f"cannot read {local_path}: {exc}")
        if not isinstance(local_fleet, dict) or local_fleet.get("version") != "delegate-fleet.local.v1" or not isinstance(local_fleet.get("lanes"), dict):
            die(f"{local_path} is not a valid delegate-fleet.local.v1 map")
    else:
        local_fleet = {"version": "delegate-fleet.local.v1", "lanes": {}}

    lane_override: dict[str, object] = {"model": args.model}
    if getattr(args, "fallbacks", None):
        fallbacks = [f.strip() for f in args.fallbacks.split(",") if f.strip()]
        if fallbacks:
            lane_override["fallbacks"] = fallbacks
    local_fleet["lanes"][lane] = lane_override

    local_path.parent.mkdir(parents=True, exist_ok=True, mode=0o755)
    atomic_write(local_path, json_bytes(local_fleet), 0o644)

    code, err = run_project_generator(paths, project_dir)
    if code != 0:
        if previous_bytes is not None:
            atomic_write(local_path, previous_bytes, 0o644)
        else:
            local_path.unlink(missing_ok=True)
        if err:
            print(err, file=sys.stderr)
        return 1

    agent_file = project_dir / ".claude" / "agents" / f"fleet-{lane}.md"
    print(f"Wrote {agent_file}.")
    print("Restart Claude Code (or start a new session) in this project to use it.")
    return 0


def cmd_project_unpin(paths: Paths, args: argparse.Namespace) -> int:
    project_dir = Path(args.dir).expanduser().resolve() if getattr(args, "dir", None) else Path.cwd().resolve()
    check_project_target(paths, project_dir)
    lane = args.lane
    if lane.startswith("fleet-"):
        lane = lane[len("fleet-"):]

    local_path = project_dir / ".claude" / "fleet.local.json"
    if not local_path.is_file():
        die(f"lane '{lane}' is not pinned in this project")

    try:
        previous_bytes = local_path.read_bytes()
        local_fleet = json.loads(previous_bytes.decode("utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError) as exc:
        die(f"cannot read {local_path}: {exc}")

    if not isinstance(local_fleet, dict) or local_fleet.get("version") != "delegate-fleet.local.v1" or not isinstance(local_fleet.get("lanes"), dict):
        die(f"{local_path} is not a valid delegate-fleet.local.v1 map")

    if lane not in local_fleet["lanes"]:
        die(f"lane '{lane}' is not pinned in this project")

    del local_fleet["lanes"][lane]
    atomic_write(local_path, json_bytes(local_fleet), 0o644)

    code, err = run_project_generator(paths, project_dir)
    if code != 0:
        atomic_write(local_path, previous_bytes, 0o644)
        if err:
            print(err, file=sys.stderr)
        return 1

    agent_file = project_dir / ".claude" / "agents" / f"fleet-{lane}.md"
    print(f"Unpinned lane '{lane}' from {local_path}.")
    print(f"Pruned {agent_file}.")
    return 0


def cmd_project_show(paths: Paths, args: argparse.Namespace) -> int:
    project_dir = Path(args.dir).expanduser().resolve() if getattr(args, "dir", None) else Path.cwd().resolve()
    local_path = project_dir / ".claude" / "fleet.local.json"
    agents_dir = project_dir / ".claude" / "agents"
    agent_files = sorted(agents_dir.glob("fleet-*.md")) if agents_dir.is_dir() else []

    local_fleet: dict = {}
    if local_path.is_file():
        try:
            local_fleet = json.loads(local_path.read_text(encoding="utf-8"))
        except (OSError, UnicodeError, json.JSONDecodeError):
            local_fleet = {}

    lanes = local_fleet.get("lanes", {}) if isinstance(local_fleet, dict) else {}
    if not lanes and not agent_files:
        print("No project lane overrides.")
        return 0

    if lanes:
        print("Project lane pins:")
        for lane_name, cfg in sorted(lanes.items()):
            model = cfg.get("model", "unknown") if isinstance(cfg, dict) else "unknown"
            fallbacks = cfg.get("fallbacks") if isinstance(cfg, dict) else None
            fb_str = f" (fallbacks: {', '.join(fallbacks)})" if fallbacks else ""
            print(f"  {lane_name} -> {model}{fb_str}")
    if agent_files:
        print("Project agent files:")
        for af in agent_files:
            print(f"  {af.name}")
    return 0


def cmd_project(paths: Paths, args: argparse.Namespace) -> int:
    sub_handlers = {
        "pin": cmd_project_pin,
        "unpin": cmd_project_unpin,
        "show": cmd_project_show,
    }
    action = getattr(args, "project_command", None)
    if not action or action not in sub_handlers:
        print("agentfleet: project requires an action: pin, unpin, show", file=sys.stderr)
        return 2
    return sub_handlers[action](paths, args)


def current_release(paths: Paths) -> Path | None:
    try:
        version = (paths.releases / "current").read_text(encoding="utf-8").strip()
    except OSError:
        return None
    if not re.fullmatch(r"[0-9]+\.[0-9]+\.[0-9]+", version):
        return None
    release = paths.releases / "releases" / version
    return release if (release / "bin" / "install.py").is_file() else None


def _base_url() -> str:
    return os.environ.get("AGENTFLEET_BASE_URL", DEFAULT_BASE_URL).rstrip("/")


def _validate_url(url: str) -> None:
    if not url.startswith("https://") and urllib.parse.urlparse(url).hostname not in {"127.0.0.1", "localhost"}:
        die("AGENTFLEET_BASE_URL must use https")


class DownloadError(Exception):
    pass


def _run_installer(paths: Paths, extra_args: list, version: str | None = None, output=None, configure_args=None) -> int:
    """Download and run install.sh / install.ps1. Shared by cmd_update and
    auto-update --run; with ``output`` (a file), all installer output goes
    there. Raises DownloadError when the script cannot be fetched."""
    base = _base_url()
    windows = os.name == "nt"
    url = f"{base}/install.ps1" if windows else f"{base}/install.sh"
    _validate_url(url)
    with tempfile.TemporaryDirectory(prefix="agentfleet-update-") as temp:
        script = Path(temp) / Path(url).name
        request = urllib.request.Request(url, headers={"User-Agent": f"agentfleet/{installed_version(paths) or 'unknown'}"})
        try:
            with urllib.request.urlopen(request, timeout=30) as response:
                script.write_bytes(response.read())
        except (urllib.error.URLError, OSError) as exc:
            raise DownloadError(f"could not download {url}: {exc}") from exc
        forwarded = ["--home", str(paths.home), "--config-home", str(paths.config), *extra_args]
        run_env = {k: v for k, v in os.environ.items() if k not in ("AGENTFLEET_PRESET", "AGENTFLEET_CONFIGURE_ARGS")}
        if configure_args:
            run_env["AGENTFLEET_CONFIGURE_ARGS"] = json.dumps(configure_args)
        if version:
            run_env["AGENTFLEET_VERSION"] = version
        run_env["AGENTFLEET_NONINTERACTIVE"] = "1"
        if windows:
            shell = shutil.which("pwsh") or shutil.which("powershell")
            if not shell:
                raise DownloadError("PowerShell is required to update")
            command = [shell, "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", str(script), *forwarded]
        else:
            command = ["sh", str(script), *forwarded]
        return subprocess.run(command, stdout=output, stderr=subprocess.STDOUT if output else None, env=run_env).returncode


# ---------------------------------------------------------------------------
# Auto-update state helpers
# ---------------------------------------------------------------------------

def _parse_version(v: str) -> tuple[int, int, int] | None:
    m = re.fullmatch(r"(\d+)\.(\d+)\.(\d+)", v)
    return (int(m.group(1)), int(m.group(2)), int(m.group(3))) if m else None


def _now_iso() -> str:
    return dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def _fetch_latest_version(paths: Paths) -> str | None:
    """Fetch latest.json; return version string or None on any failure."""
    base = _base_url()
    url = f"{base}/releases/latest.json"
    try:
        _validate_url(url)
    except SystemExit:
        return None
    try:
        request = urllib.request.Request(url, headers={"User-Agent": f"agentfleet/{installed_version(paths) or 'unknown'}"})
        with urllib.request.urlopen(request, timeout=3) as response:
            data = json.loads(response.read().decode("utf-8"))
        if not isinstance(data, dict):
            return None
        v = data.get("version")
        return v if isinstance(v, str) and _parse_version(v) else None
    except Exception:
        return None


def _auto_update_log(paths: Paths) -> Path:
    return paths.store / "auto-update.log"


def _trim_log_if_needed(log_path: Path) -> None:
    try:
        size = log_path.stat().st_size
        if size > 1_000_000:
            data = log_path.read_bytes()
            half = data[len(data) // 2:]
            atomic_write(log_path, half, 0o600)
    except OSError:
        pass


def _append_log(log_path: Path, text: str) -> None:
    paths_parent = log_path.parent
    paths_parent.mkdir(parents=True, exist_ok=True)
    try:
        _trim_log_if_needed(log_path)
        with open(log_path, "a", encoding="utf-8") as fh:
            fh.write(text)
        try:
            os.chmod(log_path, 0o600)
        except OSError:
            pass
    except OSError:
        pass


# ---------------------------------------------------------------------------
# Auto-update commands
# ---------------------------------------------------------------------------

def _auto_update_run(paths: Paths, version: str) -> None:
    """Exclusive-lock, run installer, record result. Called from --run or sync mode."""
    import time as _time
    lock_path = paths.store / "auto-update.lock"
    log_path = _auto_update_log(paths)
    paths.store.mkdir(parents=True, exist_ok=True)

    def _try_open_lock() -> "tuple[int, bool]":
        """Return (fd, took_stale). Raises OSError if truly locked."""
        try:
            fd = os.open(str(lock_path), os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
            return fd, False
        except FileExistsError:
            pass
        # Check staleness (> 1 h)
        try:
            mtime = lock_path.stat().st_mtime
            if (_time.time() - mtime) < 3600:
                raise OSError("lock held by another process")
            lock_path.unlink(missing_ok=True)
            fd = os.open(str(lock_path), os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
            return fd, True
        except FileExistsError:
            raise OSError("lock held by another process")

    try:
        fd, took_stale = _try_open_lock()
    except OSError:
        _append_log(log_path, f"[{_now_iso()}] auto-update lock held; skipping\n")
        return

    try:
        pid_info = f"pid={os.getpid()} time={_now_iso()}\n"
        os.write(fd, pid_info.encode())
        os.close(fd)
        fd = -1

        _append_log(log_path, f"[{_now_iso()}] auto-update starting: {version}\n")
        try:
            _trim_log_if_needed(log_path)
            with open(log_path, "a", encoding="utf-8") as log:
                log.flush()
                code = _run_installer(paths, [], version=version, output=log)
            ok = code == 0
            _append_log(log_path, f"[{_now_iso()}] auto-update {'succeeded' if ok else 'failed'}: {version} (exit {code})\n")
        except (DownloadError, OSError) as exc:
            ok = False
            _append_log(log_path, f"[{_now_iso()}] auto-update failed: {version}: {exc}\n")

        result = {"version": version, "ok": ok, "time": _now_iso()}
        _update_auto_update_state(paths, lambda state: state.update(lastResult=result, reported=False),
                                  timeout=LOCK_TIMEOUT, required=True)
    finally:
        if fd >= 0:
            try:
                os.close(fd)
            except OSError:
                pass
        try:
            lock_path.unlink(missing_ok=True)
        except OSError:
            pass


def cmd_auto_update(paths: Paths, args: argparse.Namespace) -> int:
    """agentfleet auto-update [--hook | --run X.Y.Z | on | off | status]"""
    subcommand = ("--hook" if args.hook else "--run" if args.run
                  else "--agent-brain" if getattr(args, "agent_brain", False) else args.action)
    au_version = args.run

    if subcommand == "on":
        if not _update_auto_update_state(paths, lambda state: state.update(enabled=True), timeout=LOCK_TIMEOUT):
            die(f"another fleet writer is busy; try again in a moment (lock: {provider_catalog.lock_path(paths.home)})")
        print("AgentFleet auto-update enabled.")
        return 0

    if subcommand == "off":
        if not _update_auto_update_state(paths, lambda state: state.update(enabled=False), timeout=LOCK_TIMEOUT):
            die(f"another fleet writer is busy; try again in a moment (lock: {provider_catalog.lock_path(paths.home)})")
        print("AgentFleet auto-update disabled.")
        return 0

    if subcommand == "status":
        state = _read_auto_update_state(paths)
        enabled = state.get("enabled", True)
        env_override = os.environ.get("AGENTFLEET_AUTO_UPDATE")
        if env_override == "0":
            status_str = "disabled (AGENTFLEET_AUTO_UPDATE=0)"
        elif enabled:
            status_str = "enabled"
        else:
            status_str = "disabled"
        print(f"auto-update: {status_str}")
        print(f"installed version: {installed_version(paths) or 'unknown'}")
        last_check = state.get("lastCheck")
        print(f"last check: {last_check or 'never'}")
        latest = state.get("latestSeen")
        print(f"latest seen: {latest or 'unknown'}")
        last_result = state.get("lastResult")
        if last_result and isinstance(last_result, dict):
            ok_str = "ok" if last_result.get("ok") else "failed"
            print(f"last result: {last_result.get('version', '?')} {ok_str} at {last_result.get('time', '?')}")
        else:
            print("last result: none")
        return 0

    if subcommand == "--run":
        # --run X.Y.Z: background worker
        version = au_version
        if not version or not _parse_version(version):
            print("agentfleet: auto-update --run requires a valid version", file=sys.stderr)
            return 1
        _auto_update_run(paths, version)
        return 0

    if subcommand == "--agent-brain":
        # Background worker for agent-brain updates.
        _agent_brain_update_run(paths)
        return 0

    if subcommand == "--hook":
        # SessionStart entry point — always exit 0, never raise
        try:
            _auto_update_hook(paths)
        except Exception:
            pass
        return 0

    print("agentfleet: unknown auto-update subcommand", file=sys.stderr)
    return 1


def _auto_update_hook(paths: Paths) -> None:
    """Core logic for --hook; exceptions are caught by caller."""
    settings = read_json(paths.settings)
    self_heal_markers(paths, settings)
    if current_kind(settings) == "native":
        try:
            result = context_sync_module(paths).update_context(
                {"hook_event_name": "SessionStart"}, paths.home, paths.config,
            )
            if result and result.get("systemMessage"):
                print(result["systemMessage"])
        except Exception:
            pass
    state = _read_auto_update_state(paths)

    # 1a. Report finished background update
    last_result = state.get("lastResult")
    reported = state.get("reported", True)
    if isinstance(last_result, dict) and not reported:
        ver = last_result.get("version", "?")
        ok = last_result.get("ok", False)
        if ok:
            print(f"AgentFleet was updated to {ver} automatically.")
        else:
            log_path = _auto_update_log(paths)
            print(f"AgentFleet auto-update to {ver} failed; see {log_path}")
        _update_auto_update_state(paths, lambda current: current.update(reported=True), timeout=2.0, required=True)
        return

    # 1b. Check disabled
    if os.environ.get("AGENTFLEET_AUTO_UPDATE") == "0":
        return
    if not state.get("enabled", True):
        return

    # 1b'. agent-brain: report a finished update, and check once a day. Its
    # failure must not cost AgentFleet's own update check.
    try:
        _agent_brain_update_hook(paths, state)
    except Exception:
        pass

    # 1c. Skip if not a release install
    if current_release(paths) is None:
        return

    # 1d. Throttle: at most once per 24 h
    last_check = state.get("lastCheck")
    if last_check:
        try:
            last_dt = dt.datetime.fromisoformat(last_check.replace("Z", "+00:00"))
            now = dt.datetime.now(dt.timezone.utc)
            if (now - last_dt).total_seconds() < 86400:
                return
        except (ValueError, TypeError):
            pass

    # 1e. Fetch latest.json
    latest_version = _fetch_latest_version(paths)
    checked = {"lastCheck": _now_iso(), **({"latestSeen": latest_version} if latest_version else {})}
    state.update(checked)
    _update_auto_update_state(paths, lambda current: current.update(checked), timeout=2.0, required=True)

    if not latest_version:
        return

    current_ver = installed_version(paths)
    if not current_ver:
        return

    latest_t = _parse_version(latest_version)
    current_t = _parse_version(current_ver)
    if not latest_t or not current_t:
        return

    if latest_t <= current_t:
        return  # already up to date

    # Different major version: notify once, do not install
    if latest_t[0] != current_t[0]:
        major_notified = state.get("majorNotified", "")
        if major_notified != latest_version:
            print(f"AgentFleet {latest_t[0]}.0.0 is available; run agentfleet update to upgrade.")
            _update_auto_update_state(paths, lambda current: current.update(majorNotified=latest_version),
                                      timeout=2.0, required=True)
        return

    # Same major, newer: spawn (or run sync for tests)
    if os.environ.get("AGENTFLEET_AUTO_UPDATE_SYNC") == "1":
        _auto_update_run(paths, latest_version)
        return

    # Spawn detached background process
    agentfleet_script = Path(sys.argv[0]).resolve()
    cmd = [sys.executable, str(agentfleet_script),
           "--home", str(paths.home), "--config-home", str(paths.config),
           "auto-update", "--run", latest_version]
    if os.name == "nt":
        DETACHED_PROCESS = 0x00000008
        CREATE_NEW_PROCESS_GROUP = 0x00000200
        subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL,
                         creationflags=DETACHED_PROCESS | CREATE_NEW_PROCESS_GROUP)
    else:
        subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)


def _agent_brain_update_due(paths: Paths, state: dict) -> bool:
    if provider_catalog.load_preferences(paths.home)["agentBrain"] is False:
        return False
    # Only the copy in agent-brain's standard folder, which this or
    # agent-brain's own installer put there; never one a package manager owns.
    target = agent_brain.managed_binary(paths.home)
    if target.is_symlink() or not target.is_file():
        return False
    last_check = state.get("agentBrainCheck")
    if isinstance(last_check, str):
        try:
            last_dt = dt.datetime.fromisoformat(last_check.replace("Z", "+00:00"))
            if (dt.datetime.now(dt.timezone.utc) - last_dt).total_seconds() < 86400:
                return False
        except (ValueError, TypeError):
            pass
    return True


def _agent_brain_update_hook(paths: Paths, state: dict) -> None:
    result = state.get("agentBrainResult")
    if isinstance(result, dict) and state.get("agentBrainReported") is False:
        print(f"agent-brain was updated to {result.get('version', '?')} automatically.")
        _update_auto_update_state(paths, lambda current: current.update(agentBrainReported=True), timeout=2.0, required=True)
    if not _agent_brain_update_due(paths, state):
        return
    checked = _now_iso()
    _update_auto_update_state(paths, lambda current: current.update(agentBrainCheck=checked), timeout=2.0, required=True)
    if os.environ.get("AGENTFLEET_AUTO_UPDATE_SYNC") == "1":
        _agent_brain_update_run(paths)
        return
    cmd = [sys.executable, str(Path(sys.argv[0]).resolve()),
           "--home", str(paths.home), "--config-home", str(paths.config),
           "auto-update", "--agent-brain"]
    if os.name == "nt":
        subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         creationflags=0x00000008 | 0x00000200)  # DETACHED_PROCESS | CREATE_NEW_PROCESS_GROUP
    else:
        subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)


def _agent_brain_update_run(paths: Paths) -> None:
    """Install a newer agent-brain over the managed copy. Only a finished
    update is reported at the next start; a failure goes to the log."""
    log_path = _auto_update_log(paths)
    try:
        version = agent_brain.update(paths.home)
    except (agent_brain.AgentBrainError, OSError) as exc:
        _append_log(log_path, f"[{_now_iso()}] agent-brain update failed: {exc}\n")
        return
    if version is None:
        return
    _append_log(log_path, f"[{_now_iso()}] agent-brain updated to {version}\n")
    # A newer agent-brain may write its hooks differently (0.5.5 changed them
    # for Windows), so let it rewrite the hooks that run this copy.
    # The preference is read again: `config agent-brain off` may have run
    # since this update started, and its hooks must not come back.
    target = agent_brain.managed_binary(paths.home)
    if (provider_catalog.load_preferences(paths.home)["agentBrain"] is not False
            and agent_brain.hooks_run(paths.home, target)):
        code, output = agent_brain.connect(paths.home, target)
        if code != 0:
            _append_log(log_path, f"[{_now_iso()}] agent-brain could not refresh its Claude Code hooks: {output}\n")
    result = {"version": version, "ok": True, "time": _now_iso()}
    _update_auto_update_state(paths, lambda state: state.update(agentBrainResult=result, agentBrainReported=False),
                              timeout=LOCK_TIMEOUT, required=True)


def cmd_update(paths: Paths, args: argparse.Namespace) -> int:
    try:
        forwarded = list(getattr(args, "installer_args", []))
        # REMAINDER can contain configure flags after installer positional args.
        yes = getattr(args, "yes", False)
        preset = getattr(args, "preset", None)
        remaining = []
        index = 0
        while index < len(forwarded):
            item = forwarded[index]
            if item == "--yes":
                yes = True
            elif item == "--preset":
                index += 1
                if index >= len(forwarded):
                    die("update --preset requires a file", 2)
                preset = forwarded[index]
            else:
                remaining.append(item)
            index += 1
        if yes and preset:
            die("update accepts only one of --yes and --preset", 2)
        forwarded = remaining
        if getattr(args, "no_configure", False):
            forwarded.append("--no-configure")
        if os.environ.get("AGENTFLEET_MODS") == "0" and "--mods" not in forwarded and "--no-mods" not in forwarded:
            forwarded.append("--no-mods")
        if not yes and not preset and os.environ.get("AGENTFLEET_PRESET"):
            preset = os.environ["AGENTFLEET_PRESET"]
        configure_args = []
        if yes:
            configure_args.append("--yes")
        if preset:
            configure_args += ["--preset", str(Path(preset).expanduser().resolve())]
        return _run_installer(paths, forwarded, configure_args=configure_args) if configure_args else _run_installer(paths, forwarded)
    except DownloadError as exc:
        die(str(exc))


def cmd_uninstall(paths: Paths, _args: argparse.Namespace) -> int:
    release = current_release(paths)
    if release is None:
        die("no downloaded release found; run uninstall.sh from the bundle you installed with")
    command = [sys.executable, str(release / "bin" / "install.py"), "--uninstall", "--apply",
               "--home", str(paths.home), "--config-home", str(paths.config)]
    return subprocess.run(command).returncode


def cmd_rollback(paths: Paths, args: argparse.Namespace) -> int:
    release = current_release(paths)
    if release is None:
        die("no downloaded release found; run install.py --rollback --apply from the bundle you installed with")
    command = [sys.executable, str(release / "bin" / "install.py"), "--rollback", "--apply",
               "--home", str(paths.home), "--config-home", str(paths.config)]
    if args.backup:
        command += ["--backup", str(Path(args.backup).expanduser())]
    return subprocess.run(command).returncode


def cmd_version(paths: Paths, _args: argparse.Namespace) -> int:
    meta = read_json(paths.claude / ".claude-agents-config-install.json")
    print(f"AgentFleet {meta.get('version', 'unknown')} ({meta.get('profile', 'not installed')})")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(prog="agentfleet", description="Switch providers and manage the AgentFleet subagent fleet.")
    parser.add_argument("--home", help=argparse.SUPPRESS)
    parser.add_argument("--prefix", help=argparse.SUPPRESS)
    parser.add_argument("--config-home", help=argparse.SUPPRESS)
    parser.add_argument("--lock-timeout", type=float, help=argparse.SUPPRESS)
    sub = parser.add_subparsers(dest="command", metavar="command")
    sub.add_parser("profiles", help="list saved profiles and the active one")
    use = sub.add_parser("use", help="switch to a profile ('native' = your Claude login)")
    use.add_argument("name")
    use.add_argument("--force", action="store_true", help="re-apply even if already active")
    add = sub.add_parser("add", help="add a gateway provider as a new profile (no reinstall)")
    add.add_argument("name")
    add.add_argument("--gateway-url", required=True, help="the gateway's base URL (https)")
    add.add_argument("--token-env", metavar="VAR", help="environment variable that holds the token (otherwise you are asked, input hidden)")
    add.add_argument("--allow-insecure-http", action="store_true", help="allow http:// for a loopback gateway")
    add.add_argument("--use", action="store_true", help="switch to the new profile right away")
    add.add_argument("--force", action="store_true", help="replace a profile with the same name")
    remove = sub.add_parser("remove", help="delete a saved profile and its token")
    remove.add_argument("name")
    remove.add_argument("--yes", action="store_true", help="do not ask for confirmation")
    save = sub.add_parser("save", help="save the current configuration as a named profile")
    save.add_argument("name")
    sub.add_parser("status", help="show the active profile and audit models, settings, hooks, agents, skills")
    sub.add_parser("doctor", help="verify the installation")
    sub.add_parser("sync", help="regenerate the fleet agents from the fleet map")
    config = sub.add_parser("config", help="show or change AgentFleet preferences")
    config.add_argument("setting", nargs="?", choices=("compact", "reviewer-access", "learn", "work-style", "ask-first", "branch-check", "agent-brain", "context-mode"))
    config.add_argument("value", nargs="?")
    instructions = sub.add_parser("instructions", help="check Claude Code instruction files for conflicts")
    instructions.add_argument("--project", metavar="DIR")
    instructions.add_argument("--check", action="store_true")
    configure = sub.add_parser("configure", help="configure all AgentFleet features")
    modes = configure.add_mutually_exclusive_group()
    modes.add_argument("--after-install", action="store_true")
    modes.add_argument("--yes", action="store_true")
    modes.add_argument("--preset", metavar="FILE")
    modes.add_argument("--export", metavar="FILE")
    jev = sub.add_parser("jev", help="enable, disable, or inspect fast-jev-compaction")
    jev.add_argument("action", choices=("on", "off", "status"))
    rep = sub.add_parser("report", help="summarize subagent runs and active provider outages")
    rep.add_argument("--days", type=int, default=7, help="number of days to report (default: 7)")
    rep.add_argument("--json", action="store_true", help="output report as JSON")
    sugg = sub.add_parser("suggest", help="propose plugins, MCP servers, mods, and hooks for the project")
    sugg.add_argument("--project", metavar="DIR", help="project directory to scan")
    sugg.add_argument("--json", action="store_true", help="output suggestions as JSON")
    sugg.add_argument("--dismiss", nargs="+", metavar="ID", help="dismiss suggestion IDs for this project")
    sugg.add_argument("--seen", action="store_true", help="mark suggestions as seen for this catalog version")
    sugg.add_argument("--forget", action="store_true", help="delete usage stats and suggestions store")
    sugg.add_argument("--home", default=argparse.SUPPRESS, help=argparse.SUPPRESS)
    proj = sub.add_parser("project", help="manage project-level lane overrides")
    proj_sub = proj.add_subparsers(dest="project_command", metavar="action")
    p_pin = proj_sub.add_parser("pin", help="pin a lane to a model for this project")
    p_pin.add_argument("lane", help="lane name (with or without 'fleet-' prefix)")
    p_pin.add_argument("model", help="model name")
    p_pin.add_argument("--fallbacks", metavar="A,B", help="comma-separated fallback models")
    p_pin.add_argument("--dir", metavar="DIR", help="project directory (default: current directory)")
    p_unpin = proj_sub.add_parser("unpin", help="remove a project-level lane pin")
    p_unpin.add_argument("lane", help="lane name (with or without 'fleet-' prefix)")
    p_unpin.add_argument("--dir", metavar="DIR", help="project directory (default: current directory)")
    p_show = proj_sub.add_parser("show", help="show project-level lane overrides")
    p_show.add_argument("--dir", metavar="DIR", help="project directory (default: current directory)")
    update = sub.add_parser("update", help="download and install the latest release")
    update_modes = update.add_mutually_exclusive_group()
    update_modes.add_argument("--yes", action="store_true")
    update_modes.add_argument("--preset", metavar="FILE")
    update.add_argument("--no-configure", action="store_true", help="skip the configuration wizard after the update")
    update.add_argument("installer_args", nargs=argparse.REMAINDER, help="extra arguments for the installer")
    sub.add_parser("uninstall", help="remove AgentFleet and restore your earlier settings")
    rollback = sub.add_parser("rollback", help="restore the settings and files from before the last install or update")
    rollback.add_argument("--backup", metavar="DIR", help="restore this backup snapshot instead of the newest")
    sub.add_parser("version", help="print the installed version")
    au = sub.add_parser("auto-update", help="turn automatic background updates on or off, or show their status")
    au.add_argument("action", nargs="?", choices=("on", "off", "status"), default="status")
    au.add_argument("--hook", action="store_true", help=argparse.SUPPRESS)
    au.add_argument("--run", metavar="VERSION", help=argparse.SUPPRESS)
    au.add_argument("--agent-brain", action="store_true", help=argparse.SUPPRESS)
    args = parser.parse_args()
    if args.lock_timeout is not None:
        global LOCK_TIMEOUT
        LOCK_TIMEOUT = args.lock_timeout
    if not args.command:
        parser.print_help()
        return 0
    paths = Paths(args)
    handlers = {
        "profiles": cmd_profiles, "use": cmd_use, "save": cmd_save, "status": cmd_status,
        "doctor": cmd_doctor, "sync": cmd_sync, "config": cmd_config, "configure": cmd_configure, "jev": cmd_jev,
        "update": cmd_update, "uninstall": cmd_uninstall, "rollback": cmd_rollback,
        "version": cmd_version, "auto-update": cmd_auto_update, "add": cmd_add, "remove": cmd_remove,
        "report": cmd_report, "suggest": cmd_suggest, "project": cmd_project, "instructions": cmd_instructions,
    }
    return handlers[args.command](paths, args)


if __name__ == "__main__":
    raise SystemExit(main())
